<launch>
  <!-- 
    This launch file starts the nodes necessary for basic, pre-defined movement.
    It runs the bridge to communicate with Gazebo and the basic_move node to send fixed commands.
  -->

  <!-- QCar Bridge Node -->
  <node name="qcar_targets_bridge" pkg="nodes" type="qcar_bridge.py" output="screen" />

  <!-- Basic Move Node -->
  <node name="basic_move" pkg="nodes" type="basic_move.py" output="screen">
    <!-- You can adjust these parameters as needed -->
    <param name="velocity" value="0.5" />
    <param name="steering" value="0.0" />
  </node>
</launch>
